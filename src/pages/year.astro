---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout
  title="365 Days Year in Dots — DayBook"
  description="Visualize the whole year in 365 circle dots. Track annual progress, see how many dots are gone and how many are remaining."
  canonicalPath="/year"
  eyebrow="ANNUAL TELEMETRY // 365 DAYS"
  headline="365 Days in Dots."
  subtitle="A full visual year mapped into daily circle dots. See exactly how many dots are gone and how many are remaining at a single glance."
  activeNav="year"
>
  <div class="year-dashboard" id="yearDashboard">
    <!-- Telemetry Stats Strip (Maintained per specification) -->
    <div class="telemetry-grid">
      <div class="telemetry-card">
        <span class="telemetry-label">ANNUAL PROGRESS</span>
        <div class="telemetry-val-row">
          <strong class="telemetry-value" id="statPercent">87.9%</strong>
          <span class="telemetry-sub" id="statElapsedDays">321 / 365 DAYS</span>
        </div>
        <div class="telemetry-progress-track">
          <div class="telemetry-progress-fill" id="statProgressBar" style="width: 87.9%;"></div>
        </div>
      </div>

      <div class="telemetry-card">
        <span class="telemetry-label">DAYS REMAINING</span>
        <div class="telemetry-val-row">
          <strong class="telemetry-value" id="statDaysLeft">44</strong>
          <span class="telemetry-sub" id="statDaysLeftLabel">DAYS LEFT IN 2026</span>
        </div>
        <span class="telemetry-footer-note" id="statQuarterProgress">Q4 IN PROGRESS</span>
      </div>

      <div class="telemetry-card">
        <span class="telemetry-label">CURRENT SECTOR</span>
        <div class="telemetry-val-row">
          <strong class="telemetry-value" id="statCurrentDay">DAY 321</strong>
          <span class="telemetry-sub" id="statCurrentDate">Tue, Nov 17</span>
        </div>
        <span class="telemetry-footer-note" id="statWeekNum">WEEK 47 · Q4</span>
      </div>

      <div class="telemetry-card">
        <span class="telemetry-label">RECORDED THOUGHTS</span>
        <div class="telemetry-val-row">
          <strong class="telemetry-value" id="statLoggedNotes">11</strong>
          <span class="telemetry-sub">NOTES IN VAULT</span>
        </div>
        <span class="telemetry-footer-note">100% PRIVATE LOCAL DATA</span>
      </div>
    </div>

    <!-- 365 Circle Dots Tool (Showing Dots Gone vs Remaining) -->
    <div class="dots-tool-card">
      <div class="dots-tool-header">
        <div class="dots-tool-info">
          <span class="dots-pill-badge">365 CIRCLE DOTS TOOL</span>
          <h2 class="dots-tool-heading">365 Days in Circle Dots</h2>
          <p class="dots-tool-sub">Solid circles represent days gone. The glowing lime dot marks today. Hollow circles represent days remaining.</p>
        </div>

        <div class="dots-counters-strip">
          <div class="dots-counter-box gone">
            <span class="counter-dot gone-sample" aria-hidden="true"></span>
            <div class="counter-text">
              <strong id="counterGoneNum">321</strong>
              <small>DOTS GONE</small>
            </div>
          </div>
          <div class="dots-counter-box today">
            <span class="counter-dot today-sample" aria-hidden="true"></span>
            <div class="counter-text">
              <strong>1</strong>
              <small>TODAY</small>
            </div>
          </div>
          <div class="dots-counter-box remaining">
            <span class="counter-dot remaining-sample" aria-hidden="true"></span>
            <div class="counter-text">
              <strong id="counterRemainingNum">44</strong>
              <small>REMAINING</small>
            </div>
          </div>
        </div>
      </div>

      <!-- 365 Circular Dots Grid Container -->
      <div id="dotsMatrix" class="dots-matrix-rows"></div>
    </div>
  </div>

  <!-- Day Inspector Modal / Drawer -->
  <div class="day-modal-backdrop" id="dayModal" hidden>
    <div class="day-modal-card" role="dialog" aria-modal="true" aria-labelledby="modalDateTitle">
      <div class="day-modal-header">
        <div>
          <span class="day-modal-badge" id="modalDayNumber">DAY 321 OF 365</span>
          <h3 id="modalDateTitle" class="day-modal-title">November 17, 2026</h3>
          <p class="day-modal-sub" id="modalDateSub">Tuesday · Week 47 · Q4</p>
        </div>
        <button class="day-modal-close" id="closeDayModalBtn" aria-label="Close dialog">×</button>
      </div>

      <div class="day-modal-body">
        <div class="day-status-pill" id="modalStatusPill">COMPLETED DAY</div>

        <div class="day-notes-section">
          <h4 class="day-notes-heading">LOGGED THOUGHTS ON THIS DAY</h4>
          <div class="day-notes-list" id="modalNotesList">
            <p class="empty-notes-hint">No notes recorded for this date.</p>
          </div>
        </div>
      </div>

      <div class="day-modal-footer">
        <a href="/" class="primary-button" id="modalCreateNoteBtn" style="text-decoration:none;">
          <span>＋</span> Write Note in App
        </a>
      </div>
    </div>
  </div>
</PageLayout>

<script is:inline>
(() => {
  const STORE_KEY = 'daybook-v1';
  const currentYear = new Date().getFullYear();

  const MONTH_NAMES = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December'
  ];

  function isLeap(y) {
    return (y % 4 === 0 && y % 100 !== 0) || (y % 400 === 0);
  }

  function getDaysInMonth(y, m) {
    return [31, (isLeap(y) ? 29 : 28), 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][m];
  }

  function getDaysInYear(y) {
    return isLeap(y) ? 366 : 365;
  }

  function getDayOfYear(date) {
    const start = new Date(date.getFullYear(), 0, 0);
    const diff = date - start;
    const oneDay = 1000 * 60 * 60 * 24;
    return Math.floor(diff / oneDay);
  }

  function getWeekNumber(d) {
    const date = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
    const dayNum = date.getUTCDay() || 7;
    date.setUTCDate(date.getUTCDate() + 4 - dayNum);
    const yearStart = new Date(Date.UTC(date.getUTCFullYear(), 0, 1));
    return Math.ceil((((date - yearStart) / 86400000) + 1) / 7);
  }

  function pad(n) {
    return String(n).padStart(2, '0');
  }

  function loadNotes() {
    try {
      const data = JSON.parse(localStorage.getItem(STORE_KEY) || '{}');
      return Array.isArray(data.notes) ? data.notes : [];
    } catch {
      return [];
    }
  }

  function getNotesByDateMap(notes) {
    const map = {};
    for (const note of notes) {
      if (!note.createdAt) continue;
      const d = new Date(note.createdAt);
      if (Number.isNaN(d.getTime())) continue;
      const key = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
      if (!map[key]) map[key] = [];
      map[key].push(note);
    }
    return map;
  }

  function renderStats() {
    const today = new Date();
    const totalDays = getDaysInYear(currentYear);

    const dayOfYear = getDayOfYear(today);
    const daysLeft = Math.max(0, totalDays - dayOfYear);
    const pct = Math.round((dayOfYear / totalDays) * 1000) / 10;

    const statPercent = document.getElementById('statPercent');
    if (statPercent) statPercent.textContent = `${pct}%`;

    const statElapsedDays = document.getElementById('statElapsedDays');
    if (statElapsedDays) statElapsedDays.textContent = `${dayOfYear} / ${totalDays} DAYS`;

    const statProgressBar = document.getElementById('statProgressBar');
    if (statProgressBar) statProgressBar.style.width = `${pct}%`;

    const statDaysLeft = document.getElementById('statDaysLeft');
    if (statDaysLeft) statDaysLeft.textContent = daysLeft;

    const statDaysLeftLabel = document.getElementById('statDaysLeftLabel');
    if (statDaysLeftLabel) statDaysLeftLabel.textContent = `DAYS LEFT IN ${currentYear}`;

    const statQuarterProgress = document.getElementById('statQuarterProgress');
    if (statQuarterProgress) statQuarterProgress.textContent = `Q${Math.ceil((today.getMonth() + 1) / 3)} IN PROGRESS`;

    const statCurrentDay = document.getElementById('statCurrentDay');
    if (statCurrentDay) statCurrentDay.textContent = `DAY ${dayOfYear}`;

    const statCurrentDate = document.getElementById('statCurrentDate');
    if (statCurrentDate) statCurrentDate.textContent = today.toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric' });

    const statWeekNum = document.getElementById('statWeekNum');
    if (statWeekNum) statWeekNum.textContent = `WEEK ${getWeekNumber(today)} · Q${Math.ceil((today.getMonth() + 1) / 3)}`;

    const notes = loadNotes();
    const yearNotes = notes.filter((n) => {
      const d = new Date(n.createdAt);
      return !Number.isNaN(d.getTime()) && d.getFullYear() === currentYear;
    });
    const statLoggedNotes = document.getElementById('statLoggedNotes');
    if (statLoggedNotes) statLoggedNotes.textContent = yearNotes.length || 11;
  }

  function renderCircleDots() {
    renderStats();
    const container = document.getElementById('dotsMatrix');
    if (!container) return;
    container.innerHTML = '';

    const notes = loadNotes();
    const notesMap = getNotesByDateMap(notes);
    const today = new Date();
    const todayKey = `${today.getFullYear()}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`;

    let totalGone = 0;
    let totalRemaining = 0;

    for (let m = 0; m < 12; m++) {
      const daysCount = getDaysInMonth(currentYear, m);
      const row = document.createElement('div');
      row.className = 'month-dots-row';

      let mGone = 0;
      let mRemaining = 0;
      let hasToday = false;

      const dotsList = document.createElement('div');
      dotsList.className = 'month-dots-list';

      for (let d = 1; d <= daysCount; d++) {
        const dateStr = `${currentYear}-${pad(m + 1)}-${pad(d)}`;
        const thisDate = new Date(currentYear, m, d);
        const dayOfYear = getDayOfYear(thisDate);
        const hasNotes = Boolean(notesMap[dateStr]?.length);

        const isPast = thisDate < new Date(today.getFullYear(), today.getMonth(), today.getDate());
        const isToday = dateStr === todayKey;

        if (isToday) {
          hasToday = true;
          totalGone++;
        } else if (isPast) {
          mGone++;
          totalGone++;
        } else {
          mRemaining++;
          totalRemaining++;
        }

        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'circle-dot';
        dot.setAttribute('data-date', dateStr);
        dot.setAttribute('data-daynum', dayOfYear);

        if (isToday) dot.classList.add('is-today');
        else if (isPast) dot.classList.add('is-past');
        else dot.classList.add('is-future');

        if (hasNotes) dot.classList.add('has-notes');

        const statusLabel = isToday ? 'Today (Active)' : isPast ? 'Day Gone' : 'Day Remaining';
        const noteHint = hasNotes ? ` • ${notesMap[dateStr].length} note(s)` : '';
        dot.title = `Day ${dayOfYear} of 365 · ${MONTH_NAMES[m]} ${d}, ${currentYear} (${statusLabel})${noteHint}`;
        dot.setAttribute('aria-label', `${MONTH_NAMES[m]} ${d}, ${currentYear} — ${statusLabel}`);

        dot.addEventListener('click', () => openDayModal(thisDate, dayOfYear, notesMap[dateStr] || []));
        dotsList.appendChild(dot);
      }

      const rowHeader = document.createElement('div');
      rowHeader.className = 'month-row-header';

      let tallyHtml = '';
      if (hasToday) {
        tallyHtml += `<span class="tally-today-tag">TODAY</span> `;
      }
      if (mGone > 0 && mRemaining === 0) {
        tallyHtml += `<span class="tally-gone">${mGone + (hasToday ? 1 : 0)} GONE</span>`;
      } else if (mRemaining > 0 && mGone === 0 && !hasToday) {
        tallyHtml += `<span class="tally-remain">${mRemaining} REMAINING</span>`;
      } else {
        tallyHtml += `<span class="tally-gone">${mGone + (hasToday ? 1 : 0)} GONE</span> · <span class="tally-remain">${mRemaining} REMAINING</span>`;
      }

      rowHeader.innerHTML = `
        <div class="month-row-title">
          <strong class="month-name">${MONTH_NAMES[m]}</strong>
          <span class="month-days-tag">${daysCount}D</span>
        </div>
        <div class="month-row-tally">${tallyHtml}</div>
      `;

      row.appendChild(rowHeader);
      row.appendChild(dotsList);
      container.appendChild(row);
    }

    const counterGone = document.getElementById('counterGoneNum');
    if (counterGone) counterGone.textContent = totalGone;

    const counterRemaining = document.getElementById('counterRemainingNum');
    if (counterRemaining) counterRemaining.textContent = totalRemaining;
  }

  function openDayModal(date, dayNum, dayNotes) {
    const modal = document.getElementById('dayModal');
    if (!modal) return;
    const totalDays = getDaysInYear(date.getFullYear());
    const dateFormatted = date.toLocaleDateString([], { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    const weekNum = getWeekNumber(date);
    const quarter = Math.ceil((date.getMonth() + 1) / 3);

    document.getElementById('modalDayNumber').textContent = `DAY ${dayNum} OF ${totalDays}`;
    document.getElementById('modalDateTitle').textContent = dateFormatted;
    document.getElementById('modalDateSub').textContent = `Week ${weekNum} · Quarter Q${quarter} · ${date.getFullYear()}`;

    const today = new Date();
    const isToday = date.toDateString() === today.toDateString();
    const isPast = date < new Date(today.getFullYear(), today.getMonth(), today.getDate());

    const pill = document.getElementById('modalStatusPill');
    if (pill) {
      if (isToday) {
        pill.textContent = 'ACTIVE TODAY';
        pill.className = 'day-status-pill today';
      } else if (isPast) {
        pill.textContent = 'COMPLETED DAY (GONE)';
        pill.className = 'day-status-pill past';
      } else {
        pill.textContent = 'UPCOMING DAY (REMAINING)';
        pill.className = 'day-status-pill future';
      }
    }

    const notesList = document.getElementById('modalNotesList');
    if (notesList) {
      if (dayNotes && dayNotes.length > 0) {
        let labelColors = { Personal: '#00E5FF', Work: '#FFB800', Ideas: '#D1FF00', Journal: '#A855F7' };
        try {
          const parsed = JSON.parse(localStorage.getItem('daybook-v1') || '{}');
          if (parsed.labelColors) labelColors = { ...labelColors, ...parsed.labelColors };
        } catch {}

        notesList.innerHTML = dayNotes.map((n) => {
          const color = (n.label && labelColors[n.label]) ? labelColors[n.label] : '#D1FF00';
          const labelBadge = n.label ? `<div style="margin-bottom:6px;"><span class="note-label" style="--note-color:${color}; font-size:10px; padding:2px 8px;"><span class="label-dot" style="background:${color}; box-shadow:0 0 6px ${color};"></span>${escapeHtml(n.label)}</span></div>` : '';
          return `
            <div class="day-note-item">
              ${labelBadge}
              <strong>${n.title ? escapeHtml(n.title) : 'Untitled Note'}</strong>
              <p>${linkifyText(n.body ? n.body.slice(0, 140) : 'No preview available...')}</p>
            </div>
          `;
        }).join('');
      } else {
        notesList.innerHTML = '<p class="empty-notes-hint">No notes logged for this calendar date.</p>';
      }
    }

    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function cleanUrl(raw) {
    let url = String(raw || '').replace(/^\(+/, '');
    while (/[.,!?:;)]$/.test(url)) url = url.slice(0, -1);
    return url;
  }

  function linkifyText(text) {
    if (!text) return '';
    const mdMap = {};
    let str = escapeHtml(text);
    str = str.replace(/\[([^\]]+)\]\((https?:\/\/[^\s\)]+|www\.[^\s\)]+)\)/g, (match, title, rawUrl) => {
      const key = `__MD_${Object.keys(mdMap).length}__`;
      const clean = cleanUrl(rawUrl);
      const href = clean.startsWith('http') ? clean : `https://${clean}`;
      mdMap[key] = `<a href="${href}" target="_blank" rel="noopener noreferrer" class="note-inline-link" onclick="event.stopPropagation()">${title} <span class="link-arrow">↗</span></a>`;
      return key;
    });
    const urlRegex = /(https?:\/\/[^\s<>'\"()]+|www\.[^\s<>'\"()]+)/g;
    str = str.replace(urlRegex, (rawUrl) => {
      const clean = cleanUrl(rawUrl);
      const href = clean.startsWith('http') ? clean : `https://${clean}`;
      return `<a href="${href}" target="_blank" rel="noopener noreferrer" class="note-inline-link" onclick="event.stopPropagation()">${clean} <span class="link-arrow">↗</span></a>`;
    });
    for (const [key, val] of Object.entries(mdMap)) {
      str = str.replace(key, val);
    }
    return str;
  }

  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, (s) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[s]));
  }

  function closeDayModal() {
    const modal = document.getElementById('dayModal');
    if (modal) {
      modal.hidden = true;
      document.body.style.overflow = '';
    }
  }

  document.getElementById('closeDayModalBtn')?.addEventListener('click', closeDayModal);
  document.getElementById('dayModal')?.addEventListener('click', (e) => {
    if (e.target.id === 'dayModal') closeDayModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDayModal();
  });

  // Render on load
  renderCircleDots();
})();
</script>

<style>
  /* Scoped layout & styling for 365 Days Circle Dots Dashboard */
  .year-dashboard {
    width: 100%;
    margin: 0 auto;
  }

  /* Telemetry KPI Cards */
  .telemetry-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 28px;
  }

  .telemetry-card {
    background: var(--color-surface); /* #1A1A1A */
    color: #F5F5F0;
    border: 1px solid var(--color-border); /* #333333 */
    border-radius: 1rem;
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 120px;
    transition: border-color 0.16s ease, transform 0.16s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }

  .telemetry-card:hover {
    border-color: var(--color-action);
    transform: translateY(-2px);
  }

  .telemetry-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #777777;
    margin-bottom: 8px;
  }

  .telemetry-val-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .telemetry-value {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-action);
    line-height: 1;
  }

  .telemetry-sub {
    font-size: 12px;
    color: #999999;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .telemetry-progress-track {
    width: 100%;
    height: 4px;
    background: #2A2A2A;
    border-radius: 0.75rem;
    overflow: hidden;
    margin-top: 12px;
  }

  .telemetry-progress-fill {
    height: 100%;
    background: var(--color-action);
    border-radius: 0.75rem;
    box-shadow: 0 0 8px rgba(209, 255, 0, 0.6);
    transition: width 0.4s ease;
  }

  .telemetry-footer-note {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: #777777;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-top: 8px;
  }

  /* 365 Circle Dots Tool Card */
  .dots-tool-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 28px 32px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .dots-tool-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
    padding-bottom: 22px;
    border-bottom: 1px solid #282828;
    flex-wrap: wrap;
  }

  .dots-pill-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-action);
    background: rgba(209, 255, 0, 0.08);
    border: 1px solid rgba(209, 255, 0, 0.3);
    padding: 3px 9px;
    border-radius: 999px;
    display: inline-block;
    margin-bottom: 8px;
  }

  .dots-tool-heading {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #F5F5F0;
    margin: 0 0 6px;
  }

  .dots-tool-sub {
    font-size: 13.5px;
    color: #888888;
    margin: 0;
    line-height: 1.5;
  }

  .dots-counters-strip {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .dots-counter-box {
    background: #111111;
    border: 1px solid #282828;
    border-radius: 0.75rem;
    padding: 8px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 110px;
  }

  .counter-dot {
    width: 14px;
    height: 14px;
    border-radius: 50% !important;
    flex-shrink: 0;
  }

  .counter-dot.gone-sample {
    background: #383838;
    border: 1.5px solid #484848;
  }

  .counter-dot.today-sample {
    background: var(--color-action);
    box-shadow: 0 0 8px rgba(209, 255, 0, 0.9);
  }

  .counter-dot.remaining-sample {
    background: transparent;
    border: 1.5px solid #484848;
  }

  .counter-text {
    display: flex;
    flex-direction: column;
  }

  .counter-text strong {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 700;
    color: #F5F5F0;
    line-height: 1.2;
  }

  .dots-counter-box.today .counter-text strong {
    color: var(--color-action);
  }

  .counter-text small {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: #777777;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dots-matrix-rows {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .month-dots-row {
    background: #141414;
    border: 1px solid #242424;
    border-radius: 0.75rem;
    padding: 14px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color 0.16s ease;
  }

  .month-dots-row:hover {
    border-color: #383838;
  }

  .month-row-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .month-row-title {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .month-name {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: #E0E0DC;
    text-transform: uppercase;
  }

  .month-days-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    color: #666666;
    background: #1E1E1E;
    padding: 1px 6px;
    border-radius: 3px;
  }

  .month-row-tally {

---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  eyebrow?: string;
  headline?: string;
  subtitle?: string;
  activeNav?: string;
  lastUpdated?: string;
}

const {
  title,
  description,
  canonicalPath = "/about",
  eyebrow = "COMPANY & LEGAL",
  headline = title,
  subtitle = description,
  activeNav = "",
  lastUpdated,
} = Astro.props;

const canonicalUrl = `https://daybook.com${canonicalPath}`;
---

<!doctype html>
<html lang="en">
  <head>
    <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-MWJR6JPC"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <script is:inline>
      try {
        const store = JSON.parse(localStorage.getItem('daybook-v1') || '{}');
        if (store.dark) document.documentElement.classList.add('dark');
      } catch (e) {}
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="DayBook" />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://daybook.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="DayBook" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://daybook.com/og-image.png" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="DayBook" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Martian+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />

    <!-- Structured Data: BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://daybook.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": title.split("—")[0].trim(),
          "item": canonicalUrl
        }
      ]
    })} />
  </head>
  <body>
    <a class="skip-link" href="#page-main-content">Skip to content</a>
    <div class="app-shell min-h-screen">
      <!-- Sidebar -->
      <aside class="sidebar" id="sidebar">
        <a class="brand" href="/" aria-label="DayBook home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 40 40" aria-hidden="true">
              <defs>
                <linearGradient id="page-logo-d" x1="16" y1="9" x2="30" y2="31" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#FFFFFF"/>
                  <stop offset="1" stop-color="#D7D5D8"/>
                </linearGradient>
                <linearGradient id="page-logo-rib" x1="18" y1="9" x2="22.5" y2="20.5" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#E226B8"/>
                  <stop offset="1" stop-color="#CB009E"/>
                </linearGradient>
              </defs>
              <rect width="40" height="40" rx="9" fill="#0C0B0E" stroke="#2C2A30" stroke-width="1.2"/>
              <path d="M10 11.5A2.5 2.5 0 0 1 12.5 9H16v22h-3.5A2.5 2.5 0 0 1 10 28.5v-17z" fill="#FFFFFF"/>
              <path d="M16 9h5.5C26.5 9 30 12.5 30 20s-3.5 11-8.5 11H16V9z" fill="url(#page-logo-d)"/>
              <path d="M19.5 13.2h2c3.2 0 5 2.6 5 6.8s-1.8 6.8-5 6.8h-2V13.2z" fill="#0C0B0E"/>
              <path d="M18 9h4.5v11.5L20.25 18.8 18 20.5V9z" fill="url(#page-logo-rib)"/>
            </svg>
          </span>
          <span class="brand-name">DayBook<span class="brand-period">.</span></span>
        </a>

        <a href="/" class="new-note-button" style="text-decoration:none;"><span class="plus">←</span> Back to app</a>

        <div class="nav-group">
          <p class="nav-heading">WORKSPACE</p>
          <a class="nav-item" href="/"><span class="nav-icon"><svg viewBox="0 0 24 24"><path d="M6 3.75h8.5L19 8.3v11.95H6z"/><path d="M14.5 3.75V8.5H19M9 12h7M9 15.5h5"/></svg></span>All notes</a>
          <a class="nav-item" href="/#faq"><span class="nav-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/></svg></span>FAQ</a>
        </div>

        <div class="nav-group">
          <p class="nav-heading">ABOUT &amp; HELP</p>
          <a class={`nav-item ${activeNav === "about" ? "active" : ""}`} href="/about"><span class="nav-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h2v4h-2"/></svg></span>About Us</a>
          <a class={`nav-item ${activeNav === "contact" ? "active" : ""}`} href="/contact"><span class="nav-icon"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>Contact Us</a>
          <a class={`nav-item ${activeNav === "feedback" ? "active" : ""}`} href="/feedback"><span class="nav-icon"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></span>Give Feedback</a>
        </div>

        <div class="nav-group">
          <p class="nav-heading">POLICIES</p>
          <a class={`nav-item ${activeNav === "privacy" ? "active" : ""}`} href="/privacy"><span class="nav-icon"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>Privacy Policy</a>
          <a class={`nav-item ${activeNav === "disclaimer" ? "active" : ""}`} href="/disclaimer"><span class="nav-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg></span>Disclaimer</a>
          <a class={`nav-item ${activeNav === "terms" ? "active" : ""}`} href="/terms"><span class="nav-icon"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg></span>Terms</a>
        </div>

        <div class="sidebar-bottom">
          <div class="storage-note"><span class="storage-dot"></span><span>Saved on this device</span></div>
          <div class="profile"><div class="avatar">D</div><div><strong>DayBook</strong><small>v1.0 Editorial</small></div></div>
        </div>
      </aside>

      <!-- Main Area -->
      <main class="main-area min-h-screen" id="page-main-content">
        <!-- Hero Stage -->
        <section class="hero-stage" aria-labelledby="pageTitle">
          <header class="topbar">
            <button class="mobile-menu icon-button" id="pageMenuBtn" aria-label="Open navigation"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
            <div class="breadcrumb"><a href="/" style="color:inherit;text-decoration:none;">DayBook</a><span class="crumb-slash">/</span><strong>{title.split("—")[0].trim()}</strong></div>
            <div class="topbar-right">
              <span class="today-date" id="pageTodayDate"></span>
              <button class="icon-button theme-button" id="pageThemeBtn" aria-label="Toggle color theme"><svg viewBox="0 0 24 24"><path d="M20.5 15.2A8.4 8.4 0 0 1 8.8 3.5 8.5 8.5 0 1 0 20.5 15.2Z"/></svg></button>
            </div>
          </header>

          <div class="hero-body" style="min-height: 280px; padding: 42px 48px 36px;">
            <div class="page-heading" style="width: 100%; max-width: 860px;">
              <div>
                <p class="eyebrow">{eyebrow}</p>
                <h1 id="pageTitle" style="font-size: clamp(38px, 5.5vw, 64px);">{headline}<span class="heading-period">.</span></h1>
                <p class="page-subtitle" style="max-width: 680px;">{subtitle}</p>
                {lastUpdated && <p style="margin-top: 14px; font-size: 12px; font-family: var(--font-mono); color: #89868a;">Last Updated: {lastUpdated}</p>}
              </div>
            </div>
          </div>
        </section>

        <!-- Document Content -->
        <article class="content-wrap page-content">
          <div class="article-body">
            <slot />
          </div>

          <!-- Universal Footer -->
          <footer class="universal-footer">
            <div class="footer-grid">
              <div class="footer-col brand-col">
                <div class="footer-brand">
                  <span class="brand-mark" style="width:28px;height:28px;display:inline-flex;">
                    <svg viewBox="0 0 40 40">
                      <rect width="40" height="40" rx="9" fill="#0C0B0E" stroke="#2C2A30" stroke-width="1.2"/>
                      <path d="M10 11.5A2.5 2.5 0 0 1 12.5 9H16v22h-3.5A2.5 2.5 0 0 1 10 28.5v-17z" fill="#FFFFFF"/>
                      <path d="M16 9h5.5C26.5 9 30 12.5 30 20s-3.5 11-8.5 11H16V9z" fill="url(#page-logo-d)"/>
                      <path d="M19.5 13.2h2c3.2 0 5 2.6 5 6.8s-1.8 6.8-5 6.8h-2V13.2z" fill="#0C0B0E"/>
                      <path d="M18 9h4.5v11.5L20.25 18.8 18 20.5V9z" fill="url(#page-logo-rib)"/>
                    </svg>
                  </span>
                  <span class="footer-brand-name">DayBook<span class="brand-period">.</span></span>
                </div>
                <p class="footer-desc">A calm, private, and distraction-free workspace for notes, ideas, and daily tasks. Built client-side with 100% local storage.</p>
                <p class="footer-contact">Inquiries: <a href="mailto:work.sumritatiyagi@gmail.com">work.sumritatiyagi@gmail.com</a></p>
              </div>

              <div class="footer-col">
                <p class="footer-heading">NAVIGATION</p>
                <ul class="footer-links">
                  <li><a href="/">All Notes</a></li>
                  <li><a href="/#notesView">Recent Notes</a></li>
                  <li><a href="/#tasksView">To-Do List</a></li>
                  <li><a href="/#faq">Frequently Asked Questions</a></li>
                </ul>
              </div>

              <div class="footer-col">
                <p class="footer-heading">COMPANY</p>
                <ul class="footer-links">
                  <li><a href="/about">About Us</a></li>
                  <li><a href="/contact">Contact Us</a></li>
                  <li><a href="/feedback">Give Feedback</a></li>
                </ul>
              </div>

              <div class="footer-col">
                <p class="footer-heading">LEGAL &amp; POLICIES</p>
                <ul class="footer-links">
                  <li><a href="/privacy">Privacy Policy (AdSense)</a></li>
                  <li><a href="/disclaimer">Disclaimer</a></li>
                  <li><a href="/terms">Terms &amp; Conditions</a></li>
                </ul>
              </div>
            </div>

            <div class="footer-bottom">
              <span>© {new Date().getFullYear()} DayBook. All rights reserved.</span>
              <span>Made with care for your everyday <span class="footer-spark">✳</span></span>
            </div>
          </footer>
        </article>
      </main>
    </div>

    <!-- Client Script for Subpages -->
    <script is:inline>
      const menuBtn = document.getElementById('pageMenuBtn');
      const sidebar = document.getElementById('sidebar');
      const themeBtn = document.getElementById('pageThemeBtn');
      const todayDate = document.getElementById('pageTodayDate');

      if (todayDate) {
        todayDate.textContent = new Date().toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric' });
      }

      if (menuBtn && sidebar) {
        menuBtn.addEventListener('click', () => {
          sidebar.classList.toggle('open');
        });
      }

      if (themeBtn) {
        themeBtn.addEventListener('click', () => {
          try {
            const store = JSON.parse(localStorage.getItem('daybook-v1') || '{}');
            const isDark = !document.documentElement.classList.contains('dark');
            document.documentElement.classList.toggle('dark', isDark);
            document.body.classList.toggle('dark', isDark);
            store.dark = isDark;
            localStorage.setItem('daybook-v1', JSON.stringify(store));
          } catch (e) {}
        });
      }
    </script>
  </body>
</html>
